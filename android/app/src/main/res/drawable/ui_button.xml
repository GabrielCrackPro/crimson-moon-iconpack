<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFF2F5D"
                android:endColor="#FFA30A26" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#FFFF7E9D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF8E0F26"
                android:endColor="#FF5A0716" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/ui_hair" />
        </shape>
    </item>
</selector>
